# Help-media manifest URL. Overrides the default S3 manifest used by
# <HelpMedia id="slug" />. Set this for staging builds to point at a
# staging manifest. Leave unset locally to use the production default.
#
# Note: at the time of bootstrap, the StemCounts help-media pipeline
# does not exist yet. The manifest URL is a placeholder; <HelpMedia>
# falls back to a visible warning if the manifest is unreachable, so
# the build still succeeds.
PUBLIC_HELP_MEDIA_MANIFEST_URL=
