---
/**
 * Custom theme toggle — replaces Starlight's built-in dropdown
 * `<ThemeSelect>` (Light / Dark / Auto) with a single icon button
 * that flips between light and dark.
 *
 * State management mirrors Starlight's:
 *   - Theme stored in `localStorage` under key `starlight-theme`
 *   - Applied via `data-theme` attribute on `<html>`
 *   - Page boot already runs Starlight's StarlightThemeProvider which
 *     reads localStorage / prefers-color-scheme and applies the right
 *     theme before this script runs — we only handle the click.
 *
 * Mounted by Astro via the `components.ThemeSelect` override in
 * `astro.config.mjs`.
 */
---

<button
  class="custom-theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  title="Toggle theme"
>
  <svg
    class="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.querySelector(".custom-theme-toggle");
    if (!btn) return;

    function getCurrent() {
      var t = document.documentElement.dataset.theme;
      if (t === "dark" || t === "light") return t;
      return window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    btn.addEventListener("click", function () {
      var next = getCurrent() === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("starlight-theme", next);
      } catch (e) {
        /* localStorage unavailable — toggle still works for the session */
      }
      window.dispatchEvent(
        new StorageEvent("storage", {
          key: "starlight-theme",
          newValue: next,
        }),
      );
    });
  })();
</script>

<style>
  .custom-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border-radius: var(--sl-radius, 8px);
    border: 1px solid var(--sl-color-hairline);
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .custom-theme-toggle:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
  }
  .custom-theme-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .icon-sun,
  .icon-moon {
    display: none;
  }
  :root[data-theme="dark"] .custom-theme-toggle .icon-sun {
    display: block;
  }
  :root[data-theme="light"] .custom-theme-toggle .icon-moon {
    display: block;
  }
  :root:not([data-theme]) .custom-theme-toggle .icon-moon {
    display: block;
  }
</style>
