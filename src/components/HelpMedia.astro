---
/**
 * <HelpMedia id="slug" /> — emits an <img> or <video> pointing at
 * `help-media.stemcounts.com/{slug}.{ext}` directly.
 *
 * No manifest, no DB. The S3 bucket is the source of truth — Kate
 * drops a file with the matching name and it appears on the next
 * build. If the file doesn't exist, the browser fires `onerror`
 * which adds a `missing` class to the wrapper, surfacing a visible
 * "Missing media" placeholder via CSS.
 *
 * Usage in any .mdx file:
 *
 *   import HelpMedia from "../../../components/HelpMedia.astro";
 *
 *   <HelpMedia id="dashboard-overview" />
 *
 *   {/ * Override the auto-derived alt text * /}
 *   <HelpMedia id="dashboard-overview" alt="Dashboard with three projects" />
 *
 *   {/ * Add a caption (renders as <figcaption> below the media) * /}
 *   <HelpMedia id="dashboard-overview" caption="Click + New project to start." />
 *
 *   {/ * Video instead of image (resolves to .mp4 instead of .png) * /}
 *   <HelpMedia id="platform-walkthrough" kind="video" />
 */

import { helpMediaUrl, humanizeSlug, type HelpMediaKind } from "../lib/helpMedia";

interface Props {
  /** Media slug. Must match the file name in the S3 bucket (without extension). */
  id: string;
  /** Override the auto-derived humanised alt text. Pass an explicit value for any
   *  shot whose meaning isn't obvious from the slug. */
  alt?: string;
  /** Optional caption rendered below the media. */
  caption?: string;
  /** `image` (default, .png) or `video` (.mp4). */
  kind?: HelpMediaKind;
  /** Override the file extension (rare — defaults are png/mp4). */
  ext?: string;
  /** CSS width on the rendered media. Defaults to 100% of the article column. */
  width?: string;
  /** Wrap in <figure>. Default true; pass false for purely decorative shots. */
  figure?: boolean;
}

const {
  id,
  alt,
  caption,
  kind = "image",
  ext,
  width = "100%",
  figure = true,
} = Astro.props;

const url = helpMediaUrl(id, kind, ext);
const resolvedAlt = (alt ?? humanizeSlug(id)).toString();
---

<figure class="help-media" data-help-media-id={id}>
  {kind === "video" ? (
    <video
      controls
      preload="metadata"
      style={`width: ${width}; height: auto;`}
      onerror="this.closest('.help-media').classList.add('missing')"
    >
      <source src={url} type="video/mp4" />
      Your browser doesn't support inline video.
      <a href={url}>Download {id}.mp4</a>
    </video>
  ) : (
    <img
      src={url}
      alt={resolvedAlt}
      loading="lazy"
      decoding="async"
      style={`width: ${width}; height: auto;`}
      onerror="this.closest('.help-media').classList.add('missing')"
    />
  )}
  {figure && caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .help-media {
    display: block;
    margin: 1.5rem auto;
    max-width: 100%;
    padding: 0;
    border: none;
    background: none;
  }
  .help-media img,
  .help-media video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-sidebar);
  }
  .help-media figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--sl-color-text-accent);
    text-align: center;
    font-style: italic;
  }

  /* Missing-media placeholder — appears when img/video onerror fires.
     Hides the broken tag, shows a labelled box in its place using the
     wrapper's data-help-media-id attribute. Coral, matches brand. */
  .help-media.missing img,
  .help-media.missing video {
    display: none;
  }
  .help-media.missing::before {
    content: "Missing media";
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-orange-high, hsl(5 70% 38%));
    margin-bottom: 0.25rem;
  }
  .help-media.missing::after {
    content: attr(data-help-media-id);
    display: block;
    background: var(--sl-color-orange-low, hsl(5 100% 96%));
    border: 1px dashed var(--sl-color-orange, #FF6F61);
    color: var(--sl-color-orange-high, hsl(5 70% 38%));
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
  }
</style>
