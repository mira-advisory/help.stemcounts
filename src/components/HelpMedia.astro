---
/**
 * <HelpMedia id="slug" /> — emits an <img> or <video> pointing at
 * `help-media.stemcounts.com/{slug}.{ext}` directly.
 *
 * No manifest, no DB. The S3 bucket is the source of truth — drop a
 * file with the matching filename and it appears on the next build.
 * If the file isn't there, the browser fires `onerror` which adds a
 * `missing` class to the wrapper, surfacing a placeholder with the
 * exact filename to save the screenshot as plus a one-click copy
 * button.
 *
 * Usage in any .mdx file:
 *
 *   import HelpMedia from "../../../components/HelpMedia.astro";
 *
 *   <HelpMedia id="dashboard-overview" />
 *
 *   {/ * Override the auto-derived alt text * /}
 *   <HelpMedia id="dashboard-overview" alt="Dashboard with three projects" />
 *
 *   {/ * Caption renders below the media as <figcaption> * /}
 *   <HelpMedia id="dashboard-overview" caption="Click + New project to start." />
 *
 *   {/ * Video (resolves to .mp4 instead of .png) * /}
 *   <HelpMedia id="platform-walkthrough" kind="video" />
 */

import { helpMediaUrl, humanizeSlug, type HelpMediaKind } from "../lib/helpMedia";

interface Props {
  id: string;
  alt?: string;
  caption?: string;
  kind?: HelpMediaKind;
  ext?: string;
  width?: string;
  figure?: boolean;
}

const {
  id,
  alt,
  caption,
  kind = "image",
  ext,
  width = "100%",
  figure = true,
} = Astro.props;

const url = helpMediaUrl(id, kind, ext);
const filename = `${id}.${ext ?? (kind === "video" ? "mp4" : "png")}`;
const resolvedAlt = (alt ?? humanizeSlug(id)).toString();
---

<figure class="help-media" data-help-media-id={id}>
  {kind === "video" ? (
    <video
      controls
      preload="metadata"
      style={`width: ${width}; height: auto;`}
      onerror="this.closest('.help-media').classList.add('missing')"
    >
      <source src={url} type="video/mp4" />
      Your browser doesn't support inline video.
      <a href={url}>Download {filename}</a>
    </video>
  ) : (
    <img
      src={url}
      alt={resolvedAlt}
      loading="lazy"
      decoding="async"
      style={`width: ${width}; height: auto;`}
      onerror="this.closest('.help-media').classList.add('missing')"
    />
  )}
  {figure && caption && <figcaption>{caption}</figcaption>}

  <div class="missing-media-card" role="status">
    <div class="missing-media-label">Missing media</div>
    <div class="missing-media-row">
      <code class="missing-media-filename">{filename}</code>
      <button
        type="button"
        class="missing-media-copy"
        data-copy-value={filename}
        aria-label={`Copy filename ${filename} to clipboard`}
      >
        Copy
      </button>
    </div>
  </div>
</figure>

<script>
  // Wire up clipboard copy for every Missing media placeholder on the
  // page. Module script — Astro bundles + dedupes, so this runs once
  // per page regardless of how many HelpMedia components are on it.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(
    ".missing-media-copy",
  )) {
    if (btn.dataset.bound === "true") continue;
    btn.dataset.bound = "true";
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copyValue;
      if (!text) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied!";
        btn.classList.add("just-copied");
      } catch {
        btn.textContent = "Copy failed";
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove("just-copied");
      }, 1400);
    });
  }
</script>

<style>
  .help-media {
    display: block;
    margin: 1.5rem auto;
    max-width: 100%;
    padding: 0;
    border: none;
    background: none;
  }
  .help-media img,
  .help-media video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-sidebar);
  }
  .help-media figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--sl-color-text-accent);
    text-align: center;
    font-style: italic;
  }

  /* ── Missing media placeholder ────────────────────────────────── */

  /* Hidden by default — only shown when img/video onerror swaps in
     the `missing` class on the wrapper. */
  .missing-media-card {
    display: none;
  }
  .help-media.missing img,
  .help-media.missing video,
  .help-media.missing figcaption {
    display: none;
  }
  .help-media.missing .missing-media-card {
    display: block;
    background: var(--sl-color-orange-low, hsl(5 100% 96%));
    border: 1px dashed var(--sl-color-orange, #FF6F61);
    color: var(--sl-color-orange-high, hsl(5 70% 38%));
    padding: 0.75rem 1rem;
    border-radius: 8px;
  }

  .missing-media-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-orange-high, hsl(5 70% 38%));
    margin-bottom: 0.5rem;
  }

  .missing-media-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .missing-media-filename {
    flex: 1 1 auto;
    min-width: 0;
    background: rgba(0, 0, 0, 0.06);
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--sl-color-text);
    word-break: break-all;
    overflow-wrap: anywhere;
    border: none;
  }

  .missing-media-copy {
    flex: 0 0 auto;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-orange, #FF6F61);
    background: #fff;
    color: var(--sl-color-orange-high, hsl(5 70% 38%));
    font-size: 0.8rem;
    font-weight: 600;
    font-family: inherit;
    line-height: 1;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.1s ease;
  }
  .missing-media-copy:hover {
    background: var(--sl-color-orange, #FF6F61);
    color: #fff;
  }
  .missing-media-copy:active {
    transform: scale(0.97);
  }
  .missing-media-copy:focus-visible {
    outline: 2px solid var(--sl-color-orange, #FF6F61);
    outline-offset: 2px;
  }
  .missing-media-copy.just-copied {
    background: var(--sl-color-orange, #FF6F61);
    color: #fff;
  }
</style>
