---
/**
 * Replaces Starlight's stock SocialIcons slot in the header.
 *
 * Renders the "Sign in" CTA that takes the reader to the main app.
 * Sits to the LEFT of the theme toggle (Starlight renders SocialIcons
 * before ThemeSelect). Styled as a primary-action button so it reads
 * as the most prominent action in the header — same role coral CTAs
 * play in the main app.
 */
---

<a
  href="https://app.stemcounts.com"
  class="header-login"
  aria-label="Sign in to StemCounts"
>
  Sign in
  <svg
    aria-hidden="true"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M5 12h14" />
    <path d="m12 5 7 7-7 7" />
  </svg>
</a>

<style>
  .header-login {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--sl-radius, 8px);
    background: var(--cta-primary, #FF6F61);
    color: #fff;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }
  .header-login:hover {
    background: var(--cta-primary-hover, #e85a4c);
    transform: translateY(-1px);
  }
  .header-login:active {
    transform: translateY(0);
  }
  @media (max-width: 50rem) {
    .header-login {
      padding: 0.45rem 0.6rem;
      font-size: 0;
      gap: 0;
    }
    .header-login svg {
      font-size: initial;
    }
  }
</style>
